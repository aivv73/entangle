import Base
import ../upload-boundary/scan.bend as S
import ../verify-upload-mutations.bend as Files

type Change is Data:
  Change{before:String,after:String}

# Exact upstream lines make source drift fail before a native build.
def effect(+old:String,+name:String,+handler:String) -> List<&2,Change>:
  [Change{"#ifdef CID(" ++ old ++ ")","#ifdef CID(" ++ name ++ ")"},
   Change{"  io_eff(CID(" ++ old ++ "), " ++ handler ++ ");","  io_eff(CID(" ++ name ++ "), " ++ handler ++ ");"}]

def changes() -> List<&2,Change>:
  List.concat(&2,Change,[
    effect("Entry.open_window","open_raw","bv_open_window"),
    effect("NativeWindow.poll","poll_raw","bv_window_poll"),
    effect("NativeWindow.capture","capture","bv_window_capture"),
    effect("NativeWindow.close","close_window","bv_window_close"),
    effect("Instance.create_surface","surface_raw","bv_create_surface"),
    [Change{"  row->context=window;return io_done(e,term_pak(CID(NativeWindow),row->id));","  row->context=window;return io_done(e,row->id);"},
     Change{"  return io_done(e,bv_node(e,CID(WindowSnapshot),6,p));","  return io_done(e,bv_node(e,CID(Snapshot),6,p));"},
     Change{"  return io_done(e,term_pak(CID(Surface),row->id));","  return io_done(e,row->id);"},
     Change{"static uint32_t bv_window_coordinate(int position,uint32_t limit) {","static uint32_t bv_window_coordinate(int position) {"},
     Change{"  return !limit || position<0 ? 0 : (uint32_t)position>=limit ? limit-1 : (uint32_t)position;","  float value=(float)position;uint32_t bits;memcpy(&bits,&value,sizeof(bits));return bits;"},
     Change{"static Term bv_bool(bool value) {return value ? 1 : 0;}","static Term bv_bool(bool value) {return value ? 1 : 0;}\n// Bend 2.0.40 inlines Tool as its tag plus five words. The mouse is tag 0.\nstatic Term bv_mouse_event(Env e,uint64_t cid,int x,int y,Time time,uint32_t button,bool down) {\n  Term p[]={0,0,0,0,0,0,0,bv_window_coordinate(x),bv_window_coordinate(y),(uint32_t)time,button,bv_bool(down)};\n  return bv_node(e,cid,cid_arity(cid),p);\n}"},
     Change{"  Term p[]={0,0,1,0};events[count++]=bv_node(e,CID(Mouse),4,p);return count;","  events[count++]=term_pak(CID(Lost),0);return count;"},
     Change{"          Term p[]={bv_window_coordinate(event.xbutton.x,window->width),bv_window_coordinate(event.xbutton.y,window->height),button==Button1 ? 0 : button==Button3 ? 1 : 2,bv_bool(event.type==ButtonPress)};value=bv_node(e,CID(Mouse),4,p);","          value=bv_mouse_event(e,CID(Press),event.xbutton.x,event.xbutton.y,event.xbutton.time,button==Button1 ? 0 : button==Button2 ? 1 : 2,event.type==ButtonPress);"},
     Change{"          Term p[]={bv_window_coordinate(event.xbutton.x,window->width),bv_window_coordinate(event.xbutton.y,window->height),button>5 ? direction : 0,button>5 ? 0 : direction};value=bv_node(e,CID(Scroll),4,p);","          Term p[]={bv_window_coordinate(event.xbutton.x),bv_window_coordinate(event.xbutton.y),button>5 ? direction : 0,button>5 ? 0 : direction};value=bv_node(e,CID(Scroll),4,p);"},
     Change{"        } else value=io_node(e,CID(Move),bv_window_coordinate(event.xmotion.x,window->width),bv_window_coordinate(event.xmotion.y,window->height));","        } else value=bv_mouse_event(e,CID(Move),event.xmotion.x,event.xmotion.y,event.xmotion.time,0,false);"}]])

def line(+value:String,pairs:List<&2,Change>) -> Nat & String:
  match pairs:
    case []:(0n,value)
    case Change{+before,after} <> rest:
      Bool.pick(Nat & String,String.eq(value,before),(1n,after),line(value,rest))

def append(head:Nat & String,tail:Nat & String) -> Nat & String:
  (count,text) = head
  (rest,suffix) = tail
  (Nat.add(count,rest),text ++ "\n" ++ suffix)

def rewrite(lines:List<&2,String>,+pairs:List<&2,Change>) -> Nat & String:
  match lines:
    case []:(0n,"")
    case head <> rest:append(line(head,pairs),rewrite(rest,pairs))

def generated(result:Nat & String) -> IO(String):
  (count,text) = result
  do IO<String>:
    S.require(Nat.is_eq(count,25n),"Vulkan window adapter expected exactly 25 upstream line replacements")
    return "// Generated by tools/window-verification/generate.bend; do not edit.\n#ifndef BV_NATIVE_IMPLEMENTATION\n#error \"The Vulkan native registry must precede its window adapter\"\n#endif\n\n" ++ text

def mode(args:List<String>,+text:String) -> IO(Unit):
  match args:
    case [_,"--write"]:Files.save("src/vulkan-window.c",text)
    case [_]:
      do IO<Unit>:
        actual:String <- S.read("src/vulkan-window.c")
        S.require(String.eq(actual,text),"Vulkan window adapter differs; review upstream, build generate.bend natively, then run its binary with --write")
        IO.print("Vulkan window adapter matches pinned upstream plus Bend 2.0.40 event conversion.")
    case _:IO.die(Unit,1,"Usage: generate.bend [--write]")

def main() -> IO(Unit):
  do IO<Unit>:
    args:List<String> <- IO.args()
    +upstream:String <- S.read("deps/bend-vulkan/src/x11.c")
    +text:String <- generated(rewrite(String.lines(upstream),changes()))
    mode(args,text)

